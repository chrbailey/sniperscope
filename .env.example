# Copy this file to .env and fill in your values.
# Never commit the actual .env (it's in .gitignore).

# GitHub Personal Access Token (classic)
# Required scopes: public_repo, read:user
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Anthropic API Key
# Required for analyze.py (not extract.py or crawl.py)
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model override (optional)
# Default: claude-sonnet-4-6
ANALYSIS_MODEL=claude-sonnet-4-6

# Database mode: sqlite (default, local) or supabase
DB_MODE=sqlite
SQLITE_PATH=sniperscope.db

# Supabase credentials (only if DB_MODE=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Extraction tuning
COMMIT_LOOKBACK_DAYS=180
MAX_REPOS_PER_USER=100
MAX_COMMITS_PER_REPO=500
